                "value": "Bearer {{customer_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/customer/saved-locations/0",
              "host": ["{{baseUrl}}"],
              "path": ["customer", "saved-locations", "0"]
            }
          }
        }
